<Window x:Class="CameraGuide.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMYVUE - Camera Guide" Height="850" Width="1250" MinHeight="600" MinWidth="560"
        WindowStartupLocation="CenterScreen" Background="#F8F1E6"
        FontFamily="{StaticResource BodyFont}" SizeChanged="Window_SizeChanged">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="#5F6652" CornerRadius="16" Padding="20,12" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LUMYVUE" Foreground="White" FontSize="24" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic"/>
                    <TextBlock Text="  PrecisionSkin  ·  Camera Guide" Foreground="#D09F7C" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ScanInfoTxt" Text="Camera stopped" Foreground="#E3E3D2" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Dynamic Responsive Grid -->
        <Grid x:Name="ContentGrid" Grid.Row="1">

            <!-- Camera View Card -->
            <Border x:Name="ImageCard" Background="#2B2C26" CornerRadius="16" Padding="0" Margin="8" ClipToBounds="True">
                <Grid x:Name="CameraViewportGrid" ClipToBounds="True" Background="Transparent" SizeChanged="CameraViewportGrid_SizeChanged">
                    <Grid x:Name="ZoomLayer">
                        <Image x:Name="UploadedImageViewer"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Face-positioning guide: oval (and optional centre lines) -->
                        <Canvas x:Name="GuideCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                            <Line x:Name="CentreV" Stroke="#66FFFFFF" StrokeThickness="1.5" StrokeDashArray="2,4"/>
                            <Line x:Name="CentreH" Stroke="#66FFFFFF" StrokeThickness="1.5" StrokeDashArray="2,4"/>
                            <Ellipse x:Name="GuideOval" Stroke="#99FFFFFF" StrokeThickness="3"
                                     StrokeDashArray="4,3" Fill="Transparent"/>
                        </Canvas>
                    </Grid>

                    <!-- Top: step banner -->
                    <Border x:Name="StateBanner" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                            Background="#B3000000" CornerRadius="14" Padding="14,6" IsHitTestVisible="False">
                        <TextBlock x:Name="StateTxt" Text="" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    </Border>

                    <!-- Bottom centre: positioning instruction -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" IsHitTestVisible="False">
                        <Border x:Name="GuideBanner" Visibility="Collapsed"
                                Background="#B3000000" CornerRadius="14" Padding="16,7" HorizontalAlignment="Center">
                            <TextBlock x:Name="GuideTxt" Text="Position your face in the oval" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <!-- Live status -->
                    <TextBlock x:Name="LiveStatusTxt"
                               Text=""
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="White" Background="#99000000"
                               Padding="8,4" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                               Margin="10" IsHitTestVisible="False"/>

                    <!-- Zoom buttons (touch-sized). The picture can also be pinched with two fingers, or zoomed with the mouse wheel. -->
                    <Border x:Name="ZoomControls" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14,14,14,56"
                            Background="#99000000" CornerRadius="32" Padding="4,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=PlaceholderPanel}" Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Button x:Name="ZoomInBtn" Content="+" Style="{StaticResource ZoomButton}" ToolTip="Zoom in" Click="ZoomInBtn_Click"/>
                            <TextBlock x:Name="ZoomLevelTxt" Text="1.0×" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2"/>
                            <Button x:Name="ZoomOutBtn" Content="−" Style="{StaticResource ZoomButton}" ToolTip="Zoom out" Click="ZoomOutBtn_Click"/>
                            <Button x:Name="ZoomResetBtn" Content="⟲" FontSize="22" Style="{StaticResource ZoomButton}" ToolTip="Back to the original view" Click="ZoomResetBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Initial Placeholder -->
                    <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#x2728;" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Open Live Cam or Upload Image to Start"
                                   FontSize="16" Foreground="#A39689" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Controls Panel -->
            <Border x:Name="ControlsCard" Background="White" BorderBrush="#E9DFD1" BorderThickness="1" CornerRadius="16" Padding="25" Margin="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Camera / File Controls -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StartCamBtn" Grid.Column="0" Content="&#x1F4F7; Live Cam" Height="62" FontSize="14"
                                    Style="{StaticResource SecondaryButton}" Background="#E3E3D2" Foreground="#34362E" FontWeight="SemiBold" BorderThickness="0" Click="StartCamBtn_Click"/>

                            <Button x:Name="SnapBtn" Grid.Column="2" Content="&#x1F4F8; Snap Now" Height="62" FontSize="14"
                                    Style="{StaticResource SecondaryButton}" Background="#D09F7C" Foreground="#34362E" FontWeight="Bold" BorderThickness="0" IsEnabled="False" Click="SnapBtn_Click"/>

                            <Button x:Name="UploadBtn" Grid.Column="4" Content="&#x1F4C1; File Upload" Height="62" FontSize="14"
                                    Style="{StaticResource SecondaryButton}" Background="#E3E3D2" Foreground="#34362E" FontWeight="SemiBold" BorderThickness="0" Click="UploadBtn_Click"/>
                        </Grid>

                        <CheckBox x:Name="OvalChk" Content="Show the face oval" IsChecked="True"
                                  FontSize="14" Foreground="#34362E" Margin="0,0,0,2" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <CheckBox x:Name="CentreChk" Content="Show centre lines (height and left / right)" IsChecked="True"
                                  FontSize="14" Foreground="#34362E" Margin="0,0,0,2" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <CheckBox x:Name="SquareChk" Content="Crop to a square, like the scan screen" IsChecked="True"
                                  FontSize="14" Foreground="#34362E" Margin="0,0,0,2" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <CheckBox x:Name="MirrorChk" Content="Mirror the picture"
                                  FontSize="14" Foreground="#34362E" Margin="0,0,0,10" Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <UniformGrid x:Name="StepperGrid" Columns="3" Margin="0,2,0,6"/>
                        <TextBlock x:Name="ViewStepTxt" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#5F6652"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Camera and picture size -->
                        <Border Background="#F3E4D3" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Camera" FontSize="12" Foreground="#6B6658" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CameraCombo" Style="{StaticResource Combo}" Margin="0,0,0,10" SelectionChanged="CameraCombo_SelectionChanged"/>
                                <TextBlock Text="Picture size" FontSize="12" Foreground="#6B6658" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SizeCombo" Style="{StaticResource Combo}" SelectionChanged="SizeCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Oval size -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Smaller oval" Style="{StaticResource SecondaryButton}" Height="56" FontSize="14" Click="OvalSmaller_Click"/>
                            <Button Grid.Column="2" Content="Bigger oval" Style="{StaticResource SecondaryButton}" Height="56" FontSize="14" Click="OvalBigger_Click"/>
                        </Grid>
                        <TextBlock x:Name="OvalSizeTxt" Text="Oval size: 100%" FontSize="12" Foreground="#6B6658" Margin="0,0,0,14"/>

                        <Separator Margin="0,0,0,14" Background="#F1F5F9"/>

                        <!-- Primary Result Callout (same box as the scan screen) -->
                        <Border Background="#F8F1E6" BorderBrush="#E3E3D2" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="VerdictTxt" Text="Status: Awaiting camera / image" FontSize="14" FontWeight="Bold" Foreground="#34362E" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RegionTxt" Text="Sit so that the face fills the oval, with the eyes near the horizontal centre line. Pinch with two fingers (or use the mouse wheel) to look closer."
                                           FontSize="12" FontStyle="Italic" Foreground="#5A524B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Camera setup tool only. It does not analyse the picture."
                                   FontSize="10.5" Foreground="#6B6658" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
